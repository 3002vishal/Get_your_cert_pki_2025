<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Error</title>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
  <script>
    Swal.fire({
      icon: 'error',
      title: 'Certificate Generation Failed',
      text: "<%= message %>",
      confirmButtonText: 'Go Back'
    }).then((result) => {
      if (result.isConfirmed) {
        window.history.back();  // ✅ Go back to the previous page
      }
    });
  </script>
</body>
</html>
